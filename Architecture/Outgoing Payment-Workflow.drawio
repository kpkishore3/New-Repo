        <mxCell id="0-qRASa1SOl77WzfwFUd-10" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;5 -&amp;gt;&amp;nbsp;Upon event consumption, Payment Workflow triggers the Camunda Workflow Engine.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="0-qRASa1SOl77WzfwFUd-9" vertex="1">
