        </mxCell>
        <mxCell id="7NDJsDYtCioKvLEoEcz4-6" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;2 -&amp;gt; Payment Integrator forwards the request to the Payment Order service for converting it into canonical object. &lt;b&gt;endpoint&lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font face=&quot;Georgia&quot;&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/payment-order/payments/order/customer-payments/initiate&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="7NDJsDYtCioKvLEoEcz4-5" vertex="1">
