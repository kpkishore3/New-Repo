        <mxCell id="L-Cmx9E0AKjyRGKSpbBX-20" value="&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;3 -&amp;gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;Payment Reference Data Interface calls the Reference Data Service via REST, which queries the &lt;/font&gt;&lt;code style=&quot;font-family: Georgia;&quot; data-end=&quot;230&quot; data-start=&quot;214&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;reference_data&lt;/font&gt;&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt; database using &lt;/font&gt;&lt;code style=&quot;&quot; data-end=&quot;272&quot; data-start=&quot;246&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;findHolidayByCodeAndDate&lt;/font&gt;&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt; on the &lt;/font&gt;&lt;code style=&quot;font-family: Georgia;&quot; data-end=&quot;294&quot; data-start=&quot;280&quot;&gt;HolidayCheck&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt; table for holiday validation, and &lt;/font&gt;&lt;code style=&quot;font-family: Georgia;&quot; data-end=&quot;357&quot; data-start=&quot;329&quot;&gt;findOperationalHourDetails&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt; on the &lt;/font&gt;&lt;code style=&quot;font-family: Georgia;&quot; data-end=&quot;389&quot; data-start=&quot;365&quot;&gt;OperationalHourDetails&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt; table for operational hour checks&lt;/font&gt;&lt;/font&gt;&lt;font face=&quot;Georgia&quot;&gt;.&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;endpoints&lt;/b&gt;&lt;/font&gt; :&amp;nbsp;&lt;span style=&quot;font-weight: 600; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 102, 51); font-size: 13px;&quot;&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/reference-data/holidays/status&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-s