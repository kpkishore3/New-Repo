        <mxCell id="7NDJsDYtCioKvLEoEcz4-2" value="Outgoing Payment Workflow Flow Description" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fontStyle=1;fillColor=#FFF2CC;" parent="1" vertex="1">
