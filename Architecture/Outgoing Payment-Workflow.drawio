        <mxCell id="0-qRASa1SOl77WzfwFUd-8" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;4 -&amp;gt;Payment Workflow service listens to Kafka and initiates the payment process.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="0-qRASa1SOl77WzfwFUd-7" vertex="1">
