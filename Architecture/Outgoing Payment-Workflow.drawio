        <mxCell id="vXT19Y04ME3kIjo5FyuG-5" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;259&quot; data-start=&quot;235&quot;&gt;&amp;nbsp;2 -&amp;gt; Settlement Interface&lt;/span&gt;&lt;span style=&quot;font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; retrieves payment configuration using the Redis key &lt;/span&gt;&lt;code style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;333&quot; data-start=&quot;312&quot;&gt;&lt;font style=&quot;&quot; face=&quot;Georgia&quot;&gt;&lt;b&gt;paymentEventConfigs&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;&lt;span style=&quot;font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="vXT19Y04ME3kIjo5FyuG-4" vertex="1">
