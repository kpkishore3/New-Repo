        <mxCell id="vXT19Y04ME3kIjo5FyuG-7" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;span style=&quot;&quot; data-end=&quot;364&quot; data-start=&quot;340&quot;&gt;&amp;nbsp;3 -&amp;gt; Settlement Interface&lt;/span&gt; publishes the initiated payment event to Kafka topic &lt;code style=&quot;&quot; data-end=&quot;433&quot; data-start=&quot;418&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;b&gt;payment-topic&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;.&lt;br&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="vXT19Y04ME3kIjo5FyuG-6" vertex="1">
