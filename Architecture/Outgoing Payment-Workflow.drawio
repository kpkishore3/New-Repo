        <mxCell id="L-Cmx9E0AKjyRGKSpbBX-18" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;2 -&amp;gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 13px; font-family: Georgia;&quot; data-end=&quot;333&quot; data-start=&quot;269&quot;&gt;Fetches payment event config from Redis&lt;/span&gt;&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;&amp;nbsp;cache using key&amp;nbsp;&lt;/font&gt;&lt;code style=&quot;font-size: 13px;&quot; data-end=&quot;365&quot; data-start=&quot;344&quot;&gt;&lt;b&gt;&lt;font face=&quot;Georgia&quot;&gt;paymentEventConfigs&lt;/font&gt;&lt;/b&gt;&lt;/code&gt;&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="L-Cmx9E0AKjyRGKSpbBX-17" vertex="1">
