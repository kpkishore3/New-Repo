        <mxCell id="L-Cmx9E0AKjyRGKSpbBX-16" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;1 -&amp;gt;&amp;nbsp;&lt;span style=&quot;&quot; data-end=&quot;108&quot; data-start=&quot;88&quot;&gt;Payment Workflow&lt;/span&gt; calls the &lt;span style=&quot;&quot; data-is-only-node=&quot;&quot; data-end=&quot;155&quot; data-start=&quot;119&quot;&gt;Payment Reference Data Interface via REST API&lt;/span&gt; to check holiday and operational hour validity. &lt;b style=&quot;&quot;&gt;endpoint&lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 102, 51); font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;https://&amp;lt;subdomain&amp;gt;. ecsfin.com/api/payment-reference-data-interface/payments/reference-data-interface/ payments/{paymentInstructionId}/business-hour-status?paymentNetwork=Fedwire&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="L-Cmx9E0AKjyRGKSpbBX-15" vertex="1">
