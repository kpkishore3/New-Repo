        <mxCell id="7NDJsDYtCioKvLEoEcz4-4" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;1-&amp;gt; Channel or Source System initiates an outgoing payment request via REST API to the Payment Integrator. &lt;b style=&quot;&quot;&gt;endpoint&lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-family: Georgia; font-size: 13px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-family: Georgia; color: light-dark(rgb(0, 102, 51), rgb(105, 193, 149));&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/payment-integrator/payments/integrator/customer-payments/pain/initiate&lt;/span&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="7NDJsDYtCioKvLEoEcz4-3" vertex="1">
