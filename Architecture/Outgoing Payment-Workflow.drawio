        </mxCell>
        <mxCell id="7NDJsDYtCioKvLEoEcz4-8" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 13px;&quot;&gt;3 -&amp;gt; Payment Order publishes the payment message to the Kafka topic&lt;b style=&quot;&quot;&gt;&amp;nbsp;&lt;code style=&quot;&quot; data-end=&quot;400&quot; data-start=&quot;385&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;payment-topic&lt;/font&gt;&lt;/code&gt;.&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="7NDJsDYtCioKvLEoEcz4-7" vertex="1">
