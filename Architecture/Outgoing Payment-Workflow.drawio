        <mxCell id="0-qRASa1SOl77WzfwFUd-2" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;1-&amp;gt; Channel or Source System initiates an outgoing payment request via REST API to the Payment Integrator. &lt;b style=&quot;&quot;&gt;endpoint&lt;/b&gt;:&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/payment-integrator/payments/integrator/customer-payments/pain/initiate&lt;/span&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="0-qRASa1SOl77WzfwFUd-1" vertex="1">
          <mxGeometry width="920" height="40" as="geometry">
