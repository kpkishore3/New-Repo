        <mxCell id="Ti54t6SElnJhWPxCmksC-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;" parent="1" vertex="1">
          <mxGeometry x="1340" y="488" width="117.91" height="62" as="geometry" />
        </mxCell>
        <mxCell id="65FcNamh17j7C-3up_Mq-3" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;4.1. Persist the payment in database&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="65FcNamh17j7C-3up_Mq-1" target="65FcNamh17j7C-3up_Mq-2" edge="1">
          <mxGeometry x="-0.0769" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="65FcNamh17j7C-3up_Mq-1" value="Payment History" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="410" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="65FcNamh17j7C-3up_Mq-2" value="DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=5.965517241379246;" parent="1" vertex="1">
          <mxGeometry x="675" y="600" width="50" height="80" as="geometry" />
        </mxCell>
        <mxCell id="65FcNamh17j7C-3up_Mq-4" value="" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Cache_Redis_Product.svg;" parent="1" vertex="1">
          <mxGeometry x="850" y="638" width="50" height="42" as="geometry" />
        </mxCell>
        <mxCell id="65FcNamh17j7C-3up_Mq-5" value="4.2. Insert the payment in redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.529;entryY=-0.014;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="65FcNamh17j7C-3up_Mq-1" target="65FcNamh17j7C-3up_Mq-4" edge="1">
          <mxGeometry x="0.3156" y="-1" relative="1" as="geometry">
            <mxPoint x="561.5" y="570" as="sourcePoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MoxeD5C8FxVwT1LMKm-E-5" value="&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;An external system calls the pacs/pain initiate API exposed by the Payment Integrator.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The Payment Integrator performs ISO 20022 structure validation. If the request is valid, it converts it into a canonical format and forwards it to the Payment Order service.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;The Payment Order service calls the Payment History service to persist the request.&amp;nbsp;&lt;/li&gt;&lt;li&gt;The Payment History service handles:&lt;/li&gt;&lt;ol&gt;&lt;li&gt;idempotency check using X-Trace Id.&lt;/li&gt;&lt;li&gt;Storing the request in the database&lt;/li&gt;&lt;li&gt;Caching the request in Redis&lt;/li&gt;&lt;li&gt;(Note: All database and Redis operations are managed solely by Payment History)&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;If the request is successfully persisted, Payment Order publishes an event to the Payments topic and sends a synchronous response back to the Payment Integrator.&lt;/li&gt;&lt;li&gt;The Payment Workflow service consumes the event from the payments Kafka topic.&lt;/li&gt;&lt;li&gt;The Payment Workflow service then starts the payment initiation workflow.&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="80" y="321" width="470" height="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="BlUZyjHmya4RURl9fsBX" name="Duplicate workflow initiation check">
    <mxGraphModel dx="1360" dy="843" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zD6W3G9vmTMljlnzDzWD-3" value="1. Initiate workflow deduplication&amp;nbsp;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;check&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="zD6W3G9vmTMljlnzDzWD-1" target="JS1_GHJJSF6pEBV44GQu-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="139" y="283" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VTEzydS2uuSzYT934G_z-1" value="2. Initiate workflow deduplication check&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="JS1_GHJJSF6pEBV44GQu-1" target="zD6W3G9vmTMljlnzDzWD-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="JS1_GHJJSF6pEBV44GQu-1" value="Workflow Deduplication Worker" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="78.96" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zD6W3G9vmTMljlnzDzWD-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;" parent="1" vertex="1">
          <mxGeometry x="81.04999999999995" y="220" width="117.91" height="62" as="geometry" />
        </mxCell>
        <mxCell id="zD6W3G9vmTMljlnzDzWD-4" value="Payment Order" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="515" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="KeTSKeP3NIhVTp90SFbO-1" value="DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=5.965517241379246;" parent="1" vertex="1">
          <mxGeometry x="550" y="575" width="50" height="80" as="geometry" />
        </mxCell>
        <mxCell id="KeTSKeP3NIhVTp90SFbO-2" value="3. Check whether a duplicate workflow initiation&amp;nbsp;&lt;div&gt;has occurred for a message, such as payment, cancel, return, etc&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="zD6W3G9vmTMljlnzDzWD-4" target="KeTSKeP3NIhVTp90SFbO-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="445" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TemfnX2RDmOfdMtkGCdr-1" value="&lt;div&gt;There is a chance of multiple workflow start can happen during workflow initiation&lt;/div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;An external system calls the pacs/pain initiate API exposed by the Payment Integrator.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The Payment Integrator performs ISO 20022 structure validation. If the request is valid, it converts it into a canonical format and forwards it to the Payment Order service.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;The Payment Order service calls the Payment History service to persist the request.&lt;/li&gt;&lt;li&gt;The Payment History service handles:&lt;/li&gt;&lt;ol&gt;&lt;li&gt;Storing the request in the database&lt;/li&gt;&lt;li&gt;Caching the request in Redis&lt;/li&gt;&lt;li&gt;(Note: All database and Redis operations are managed solely by Payment History)&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;If the request is successfully persisted, Payment Order publishes an event to the Payments topic and sends a synchronous response back to the Payment Integrator.&lt;/li&gt;&lt;li&gt;The Payment Workflow service consumes the event from the payments Kafka topic.&lt;/li&gt;&lt;li&gt;The Payment Workflow service then starts the payment initiation workflow.&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="20" y="610" width="470" height="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
