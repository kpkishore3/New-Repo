        </mxCell>
        <mxCell id="Ti54t6SElnJhWPxCmksC-13" value="7. Start initiate payment workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="Ti54t6SElnJhWPxCmksC-10" target="Ti54t6SElnJhWPxCmksC-15" edge="1">
