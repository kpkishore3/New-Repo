          <mxGeometry x="760" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LHe7Z6ICN8JVXkJfCtnn-0" value="&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The workflow engine will initiate settle payment flow.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The settle payment worker will trigger the payment order to settle the payment.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The payment order will trigger the payment history to update payment status as SETTLED.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;The Payment History service handles:&lt;/span&gt;&lt;/li&gt;&lt;ol&gt;&lt;li&gt;Modify the payment status&lt;/li&gt;&lt;li&gt;Modify the payment status in cache (Redis).&lt;/li&gt;&lt;li&gt;(Note: All database and Redis operations are managed solely by Payment History)&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;If the request is successfully persisted, Payment Order publishes an event to the Payments topic and sends a synchronous response back to the Settle Payment Worker.&lt;/li&gt;&lt;/ol&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="Yfd4PJPtpotx6t8AUo6u-1" vertex="1">
          <mxGeometry x="80.96" y="600" width="470" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
