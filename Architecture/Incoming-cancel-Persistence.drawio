        <mxCell id="10y1DLBOCDB5hXZCW7sR-147" value="&lt;font face=&quot;Georgia&quot;&gt;9 -&amp;gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 13px;&quot;&gt;The payment order service is published cancel request event to the Kafka&amp;nbsp;&lt;/font&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;payment-topic&lt;/font&gt;.&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-146">
