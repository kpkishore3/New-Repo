        <mxCell id="10y1DLBOCDB5hXZCW7sR-137" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;9 -&amp;gt; Message History service consumes event&amp;nbsp; to store&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot; data-end=&quot;851&quot; data-start=&quot;823&quot;&gt;unlinked messages&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;in&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot; data-end=&quot;866&quot; data-start=&quot;855&quot;&gt;MongoDB&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-136">
