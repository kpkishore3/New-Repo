        <mxCell id="10y1DLBOCDB5hXZCW7sR-135" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;8 -&amp;gt;If payment core object is null, order service&lt;/font&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;sends the unlinked message to the&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;&quot; data-end=&quot;134&quot; data-start=&quot;108&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;Kafka&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;code style=&quot;&quot; data-end=&quot;126&quot; data-start=&quot;116&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;messages&lt;/font&gt;&lt;/code&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;topic.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-134">
