        <mxCell id="10y1DLBOCDB5hXZCW7sR-125" value="&lt;span style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;3 -&amp;gt; The Message History service consumes the cancel request message from Kafka and stores it in MongoDB.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-124">
          <mxGeometry width="1198" height="40" as="geometry">
            <mxRectangle width="1198" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-126" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-119">
          <mxGeometry y="157" width="1198" height="48" as="geometry" />
        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-127" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;4 -&amp;gt; Validate whether the cancel request is valid by ensuring that the HeaderDTO, PaymentNetwork, PartitionDate, and PaymentInstructionId are not null. If any of these are invalid, verify that the paymentCoreDTO object is not null. If the cancel request is valid, attempt to fetch data from Redis; if not found, retrieve it from the Payment History service. If the result is still null, it indicates that the incoming cancel request is unlinked.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-126">
          <mxGeometry width="1198" height="48" as="geometry">
            <mxRectangle width="1198" height="48" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-128" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-119">
          <mxGeometry y="205" width="1198" height="40" as="geometry" />
        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-129" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;5 -&amp;gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;If valid,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Fetch payment object fetch&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;from Redis cache using key&lt;/font&gt;&amp;nbsp;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;paymentCore&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-128">
          <mxGeometry width="1198" height="40" as="geometry">
            <mxRectangle width="1198" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-130" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-119">
          <mxGeometry y="245" width="1198" height="40" as="geometry" />
