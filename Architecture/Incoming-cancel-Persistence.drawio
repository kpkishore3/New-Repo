        <mxCell id="10y1DLBOCDB5hXZCW7sR-143" value="&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;8 -&amp;gt; If the&amp;nbsp;&lt;/font&gt;&lt;code style=&quot;font-size: 13px;&quot; data-end=&quot;69&quot; data-start=&quot;47&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;PaymentInstructionId&lt;/font&gt;&lt;/code&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;&amp;nbsp;is null, a&amp;nbsp;&lt;/font&gt;&lt;code style=&quot;font-family: Georgia; font-size: 13px;&quot; data-end=&quot;106&quot; data-start=&quot;81&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;RecordNotFoundException&lt;/font&gt;&lt;/code&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;is thrown and the process is&amp;nbsp;terminated.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-142">
