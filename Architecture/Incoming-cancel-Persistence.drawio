        <mxCell id="10y1DLBOCDB5hXZCW7sR-141" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;11 -&amp;gt; Payment History consumes the event and stores the data in the unlinked messages table in&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot; data-end=&quot;129&quot; data-start=&quot;94&quot;&gt;payment history database.&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-140">
