        </mxCell>
        <mxCell id="10y1DLBOCDB5hXZCW7sR-145" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;8 -&amp;gt; If Payment Instruction Id is present retrieve event configuration from the redis cache using key&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;paymentEventConfig&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;and also retrieve payment object from the redis cache using key&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;paymentCore&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="10y1DLBOCDB5hXZCW7sR-144">
