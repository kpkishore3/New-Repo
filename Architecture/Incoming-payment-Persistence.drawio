        <mxCell id="L10KTyBsZvT7zqeA45Ok-59" value="5 -&amp;gt;&amp;nbsp;&lt;span style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;Next, the Payment Order service persists the request data in Redis using key &lt;b&gt;paymentCore&lt;/b&gt;.&lt;/span&gt;&amp;nbsp;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="L10KTyBsZvT7zqeA45Ok-58">
