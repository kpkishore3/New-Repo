        <mxCell id="L10KTyBsZvT7zqeA45Ok-46" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 13px;&quot;&gt;4 -&amp;gt; The Payment History service consumes the event and stores the data in payment history database tables, as detailed below.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="L10KTyBsZvT7zqeA45Ok-45">
