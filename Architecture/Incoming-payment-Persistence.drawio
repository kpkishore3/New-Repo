        <mxCell id="L10KTyBsZvT7zqeA45Ok-40" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;1 -&amp;gt; The Payment Order service receives payment requests through REST APIs from Network Integrator Services.&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;&lt;b&gt;endpoint &lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&amp;nbsp;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 13px; color: rgb(0, 102, 51);&quot;&gt;&lt;b&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/payment-order/payments/order/customer-payments/initiate&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="L10KTyBsZvT7zqeA45Ok-39">
          <mxGeometry width="800" height="40" as="geometry">
            <mxRectangle width="800" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L10KTyBsZvT7zqeA45Ok-41" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="L10KTyBsZvT7zqeA45Ok-38">
          <mxGeometry y="70" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="L10KTyBsZvT7zqeA45Ok-42" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;2 -&amp;gt; The Payment Order service retrieves payment event configuration from Redis using the key &lt;/font&gt;&lt;code style=&quot;&quot; data-end=&quot;238&quot; data-start=&quot;218&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;b&gt;paymentEventConfig&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;&lt;font face=&quot;Georgia&quot;&gt;.&amp;nbsp;&lt;/font&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="L10KTyBsZvT7zqeA45Ok-41">
          <mxGeometry width="800" height="40" as="geometry">
