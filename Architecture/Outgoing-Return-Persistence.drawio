        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-44" value="&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;1 -&amp;gt;&amp;nbsp;Source System/Channel sends a payment return request to the Payment Order service via a REST API call.&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;&lt;b&gt;endpoint &lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 102, 51), rgb(105, 193, 149)); font-size: 13px; font-family: Georgia; font-weight: 600; background-color: transparent;&quot;&gt;https://&amp;lt;subdomain&amp;gt;.ecsfin.com/api/payment-order/payments/order/customer-payments/payment-return&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-43">
          <mxGeometry width="800" height="40" as="geometry">
            <mxRectangle width="800" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-45" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-42">
          <mxGeometry y="70" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-46" value="&lt;font face=&quot;Georgia&quot;&gt;2 -&amp;gt; Payment Order &lt;/font&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;service &lt;/font&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;fetches &lt;/font&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;payment &lt;/font&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;object &lt;/font&gt;&lt;font face=&quot;Georgia&quot;&gt;from &lt;/font&gt;&lt;font style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;the redis cache using key&lt;/font&gt;&lt;font face=&quot;Georgia&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;code style=&quot;&quot; data-end=&quot;215&quot; data-start=&quot;202&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;paymentCore&lt;/font&gt;&lt;/code&gt; &lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;and fetches payment event configuration from the redis cache using key&amp;nbsp;&lt;/font&gt;&lt;code style=&quot;&quot; data-end=&quot;241&quot; data-start=&quot;220&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;b&gt;paymentEventConfigs&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;&lt;/font&gt;&lt;font face=&quot;Georgia&quot;&gt;.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot; face=&quot;Georgia&quot;&gt;The outgoing return object is stored in Redis.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-45">
          <mxGeometry width="800" height="40" as="geometry">
            <mxRectangle width="800" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-47" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-42">
          <mxGeometry y="110" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-48" value="&lt;span style=&quot;font-family: Georgia; font-size: 13px;&quot;&gt;3 -&amp;gt;The Payment Order publishes the return message to the Kafka topic named &lt;b&gt;messages&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-47">
          <mxGeometry width="800" height="40" as="geometry">
            <mxRectangle width="800" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-49" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-42">
          <mxGeometry y="150" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mRRFG4EKOtbDVO4Hknnr-50" value="&lt;font face=&quot;Georgia&quot;&gt;4 -&amp;gt;&amp;nbsp;&lt;span style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;The Message History service consumes the return message from Kafka and stores it in MongoDB.&lt;/span&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" parent="mRRFG4EKOtbDVO4Hknnr-49">
